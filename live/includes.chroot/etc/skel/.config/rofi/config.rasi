configuration {
  modi: "drun,run,window";
  show-icons: true;
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";
  font: "Inter 12";
  drun-display-format: "{name}";
}
* {
  bg: #F2F3F5;
  fg: #252932;
  accent: #D9233F;
  muted: #65758D;
  background-color: transparent;
  text-color: @fg;
}
window {
  location: south west;
  anchor: south west;
  y-offset: -40;
  width: 34%;
  background-color: @bg;
  border: 0 0 3px 0;
  border-color: @accent;
}
mainbox { padding: 12px; spacing: 8px; }
inputbar { padding: 10px; background-color: #FFFFFF; border: 0 0 2px 0; border-color: @muted; children: [prompt, entry]; spacing: 8px; }
prompt { text-color: @accent; }
entry { placeholder: "Search applications"; placeholder-color: @muted; }
listview { lines: 10; scrollbar: false; spacing: 2px; }
element { padding: 8px 10px; spacing: 10px; }
element selected { background-color: @accent; text-color: #FFFFFF; }
element-icon { size: 1.6em; }
